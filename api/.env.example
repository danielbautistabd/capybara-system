# ---------- Servidor ----------
PORT=8080
NODE_ENV=production
PUBLIC_URL=https://control.capybarahostel.com
CORS_ORIGINS=https://control.capybarahostel.com,http://localhost:5173
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
TZ=America/Bogota
CURRENCY=COP

# ---------- Base de datos ----------
DATABASE_URL=postgresql://capybara:capybara@localhost:5432/capybara_control?schema=public

# ---------- Almacenamiento de evidencias ----------
# local | s3 | gcs  (local guarda en ./uploads)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ---------- WhatsApp Business Cloud API (Meta) ----------
# developers.facebook.com > Tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=EAAG...token-permanente-de-usuario-del-sistema
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_APP_SECRET=secreto-de-la-app-para-validar-firmas
WHATSAPP_VERIFY_TOKEN=capybara-verify-2026
WHATSAPP_GRAPH_VERSION=v21.0
# Números autorizados (E.164 sin +), separados por coma. Además se valida contra la tabla User.phone
WHATSAPP_ALLOWED_NUMBERS=573001112233,573004445566
# Responder al remitente con el resumen de lo interpretado (true/false)
WHATSAPP_SEND_ACK=true

# ---------- Google Drive / Sheets ----------
# Cuenta de servicio con acceso de LECTOR a los archivos compartidos
GOOGLE_SERVICE_ACCOUNT_EMAIL=capybara-control@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opcional: carpeta de Drive donde se exportan reportes
GOOGLE_EXPORT_FOLDER_ID=

# ---------- IA (lectura de facturas, fotos y mensajes difíciles) ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
# Transcripción de notas de voz: google | openai | none
STT_PROVIDER=google
OPENAI_API_KEY=

# ---------- Reglas de negocio ----------
AUTO_APPLY_CONFIDENCE=0.85
AUTO_APPLY_ENABLED=false
DUPLICATE_WINDOW_HOURS=12
MINOR_DIFF_PCT=0.05
MINOR_DIFF_ABS=1

# ---------- Alegra (contabilidad) ----------
# Alegra > Configuración > Integraciones > API: correo de la cuenta y token
# ALEGRA_BASE_URL=https://api.alegra.com/api/v1   # solo cambiarla para pruebas
ALEGRA_EMAIL=contabilidad@capybarahostel.com
ALEGRA_TOKEN=token-de-la-api
ALEGRA_DEFAULT_CATEGORY_ID=   # cuenta contable para compras de productos sin ítem en Alegra
ALEGRA_BANK_ACCOUNT_ID=       # banco o caja desde donde se pagan los proveedores
ALEGRA_WAREHOUSE_ID=          # bodega (opcional, por defecto la principal)
ALEGRA_TAX_IVA19_ID=          # id del impuesto IVA 19 % en Alegra
ALEGRA_TAX_IVA5_ID=
ALEGRA_TAX_INC8_ID=           # impuesto al consumo 8 % (bar y restaurante)
ALEGRA_DEFAULT_CLIENT_ID=     # contacto "Consumidor final" para facturas de venta
ALEGRA_CREDIT_DAYS=30
ALEGRA_WEBHOOK_SECRET=una-cadena-larga-aleatoria
ALEGRA_SYNC_CRON=*/30 * * * *
ALEGRA_AUTO_PUSH=false        # enviar a Alegra cada compra al aprobarla

# ---------- Inteligencia ----------
SERVICE_LEVEL=0.95            # 0.90 | 0.95 | 0.98 | 0.99 (stock de seguridad)
INSIGHTS_DAILY_CRON=30 22 * * *
INSIGHTS_WHATSAPP_TO=573001112233   # números que reciben el resumen diario

# ---------- Capacidad (módulo de socios: ocupación, ADR, RevPAB) ----------
HOSTEL_DORM_BEDS=30
HOSTEL_PRIVATE_ROOMS=6
