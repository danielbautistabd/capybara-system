{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["api/openapi.yaml", "api/prisma/schema.prisma"] } },
    { "src": "api/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(api/v1/.*|health|files/.*|webhooks/.*|openapi\\.yaml)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/api/public/index.html" },
    { "src": "/(.*)", "dest": "/api/public/$1" }
  ]
}
